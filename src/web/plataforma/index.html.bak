<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Pirate Adventure - Natasha Arcade</title>
    <style>
      @font-face {
        font-family: "ArcadeFont";
        src: url("/galaxy/assets/fonte/upheaval/upheavtt.ttf")
          format("truetype");
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
        font-family: "ArcadeFont", monospace;
        color: #fff;
      }
      #gameWrapper {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
      }
      canvas {
        width: 100%;
        height: 100%;
        display: block;
        image-rendering: pixelated;
      }

      #menuScreen {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 30;
        gap: 18px;
        background:
          radial-gradient(
            circle at 50% 22%,
            rgba(111, 205, 255, 0.22),
            transparent 20%
          ),
          radial-gradient(
            circle at 50% 70%,
            rgba(255, 203, 86, 0.12),
            transparent 35%
          ),
          linear-gradient(180deg, rgba(7, 11, 17, 0.9), rgba(13, 18, 26, 0.96));
        overflow: hidden;
        padding: 20px;
      }

      @media (max-width: 768px) {
        #menuScreen {
          gap: 16px;
          padding: 16px;
        }
      }

      @media (max-width: 480px) {
        #menuScreen {
          gap: 12px;
          padding: 12px;
        }
      }
      #menuScreen::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.05), transparent 45%),
          linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.03),
            rgba(255, 255, 255, 0.03)
          );
      }
      #menuScreen::after {
        content: "";
        position: absolute;
        inset: 8% 12%;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        pointer-events: none;
        box-shadow: inset 0 0 40px rgba(255, 209, 87, 0.08);
      }
      .game-logo-box {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 10px;
        text-align: center;
      }
      .game-title {
        font-size: clamp(38px, 7vw, 72px);
        color: #f8d764;
        text-shadow:
          0 2px 0 rgba(255, 255, 255, 0.25),
          0 12px 24px rgba(248, 215, 100, 0.28),
          0 0 18px rgba(255, 203, 86, 0.4);
        letter-spacing: 4px;
        line-height: 0.96;
        background: linear-gradient(180deg, #fff0ad, #f7c84e 32%, #d8911a 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .game-subtitle {
        font-size: clamp(11px, 1.9vw, 16px);
        color: rgba(168, 214, 255, 0.9);
        letter-spacing: 6px;
        text-transform: uppercase;
        margin-top: 8px;
        opacity: 0.92;
      }
      .menu-hint {
        position: relative;
        z-index: 3;
        margin-top: 8px;
        font-size: clamp(10px, 1.3vw, 12px);
        letter-spacing: 4px;
        color: rgba(230, 239, 255, 0.78);
      }
      .menu-wood-btn {
        position: relative;
        z-index: 3;
        width: clamp(220px, 36vw, 300px);
        height: 58px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: linear-gradient(180deg, #0a1017 0%, #121b27 100%);
        border-radius: 16px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.12),
          0 10px 24px rgba(0, 0, 0, 0.34),
          0 0 0 1px rgba(248, 215, 100, 0.18);
        color: #f5d77a;
        font-size: clamp(18px, 3vw, 24px);
        font-family: inherit;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
          transform 0.12s ease,
          filter 0.15s ease,
          box-shadow 0.12s ease;
      }
      .menu-wood-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.05);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.18),
          0 12px 26px rgba(0, 0, 0, 0.42),
          0 0 0 1px rgba(248, 215, 100, 0.28);
      }
      .menu-wood-btn:active {
        transform: translateY(1px);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.08),
          0 6px 14px rgba(0, 0, 0, 0.2);
      }

      @media (max-width: 768px) {
        .game-title {
          font-size: clamp(32px, 6vw, 54px);
        }
        .game-subtitle {
          font-size: clamp(10px, 1.6vw, 14px);
          letter-spacing: 3px;
        }
        .menu-hint {
          font-size: clamp(9px, 1.2vw, 11px);
        }
        .menu-wood-btn {
          width: clamp(200px, 70vw, 280px);
          height: 54px;
          font-size: clamp(16px, 2.8vw, 22px);
        }
        #menuScreen::after {
          inset: 12% 8%;
        }
      }

      @media (max-width: 480px) {
        .game-title {
          font-size: clamp(28px, 5.5vw, 44px);
        }
        .game-subtitle {
          font-size: clamp(9px, 1.4vw, 12px);
          letter-spacing: 2px;
        }
        .menu-hint {
          font-size: clamp(8px, 1vw, 10px);
          margin-top: 4px;
        }
        .menu-wood-btn {
          width: clamp(180px, 75vw, 260px);
          height: 50px;
          font-size: clamp(14px, 2.6vw, 18px);
        }
        #menuScreen::after {
          inset: 15% 6%;
        }
      }

      #touchControls {
        position: absolute;
        inset: 0;
        z-index: 12;
        pointer-events: none;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding: 24px;
      }
      #touchControls.hidden {
        display: none;
      }
      .touch-btn {
        pointer-events: auto;
        width: 66px;
        height: 66px;
        background: rgba(0, 242, 254, 0.25);
        border: 3px solid #00f2fe;
        border-radius: 50%;
        color: #fff;
        font-size: 26px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: none;
        backdrop-filter: blur(4px);
      }
      .touch-btn:active {
        background: #00f2fe;
        color: #000;
        transform: scale(0.92);
      }
      .d-pad-touch {
        display: flex;
        gap: 16px;
      }

      @media (max-width: 768px) {
        #touchControls {
          padding: 20px;
        }
        .touch-btn {
          width: 76px;
          height: 76px;
          font-size: 22px;
          border-width: 2.5px;
        }
        .d-pad-touch {
          gap: 14px;
        }
      }

      @media (max-width: 480px) {
        #touchControls {
          padding: 16px;
        }
        .touch-btn {
          width: 80px;
          height: 80px;
          font-size: 20px;
          border-width: 2.5px;
        }
        .d-pad-touch {
          gap: 12px;
        }
      }

      #pauseBtn,
      #muteBtn {
        display: none !important;
      }
      #pauseBtn.hidden,
      #muteBtn.hidden {
        display: none !important;
      }

      .screen-modal {
        position: absolute;
        inset: 0;
        background: rgba(4, 6, 12, 0.92);
        backdrop-filter: blur(6px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 40;
        text-align: center;
        padding: 20px;
      }
      .screen-modal.hidden {
        display: none;
      }

      @media (max-width: 480px) {
        .screen-modal {
          padding: 16px;
        }
      }
    </style>
  </head>
  <body>
    <div id="gameWrapper">
      <canvas id="gameCanvas"></canvas>

      <div id="menuScreen">
        <div class="game-logo-box">
          <div class="game-title">PIRATE ADVENTURE</div>
          <div class="game-subtitle">TREASURE HUNTERS</div>
        </div>
        <button class="menu-wood-btn" id="btnPlay">JOGAR</button>
        <button class="menu-wood-btn" id="btnOptions">OPÇÕES</button>
        <button class="menu-wood-btn" id="btnCredits">CRÉDITOS</button>
        <div class="menu-hint">TOQUE PARA COMEÇAR</div>
      </div>

      <button id="pauseBtn" class="hidden" aria-label="Pausar"></button>
      <button id="muteBtn" class="hidden" aria-label="Mutar"></button>

      <div id="touchControls" class="hidden">
        <div class="d-pad-touch">
          <button class="touch-btn" id="btnLeft">L</button>
          <button class="touch-btn" id="btnRight">R</button>
        </div>
        <button
          class="touch-btn"
          style="
            width: 76px;
            height: 76px;
            background: rgba(255, 0, 85, 0.35);
            border-color: #ff0055;
            font-size: 18px;
          "
          id="btnJump"
        >
          PULAR
        </button>
      </div>

      <div class="screen-modal hidden" id="pauseModal">
        <div style="font-size: 38px; color: #38bdf8; margin-bottom: 20px">
          PAUSADO
        </div>
        <button class="menu-wood-btn" id="resumeBtn">CONTINUAR</button>
      </div>

      <div class="screen-modal hidden" id="gameOverModal">
        <div
          style="
            font-size: 42px;
            color: #ff0055;
            text-shadow: 3px 3px 0 #660022;
            margin-bottom: 10px;
          "
        >
          FIM DE JOGO
        </div>
        <p
          id="rewardTxt"
          style="color: #00ff66; font-size: 20px; margin-bottom: 24px"
        >
          +0 NatashaCoins creditadas
        </p>
        <button class="menu-wood-btn" id="restartBtn">TENTAR DE NOVO</button>
      </div>

      <div class="screen-modal hidden" id="victoryModal">
        <div
          style="
            font-size: 42px;
            color: #ffd700;
            text-shadow:
              3px 3px 0 #7a4b00,
              0 0 24px rgba(255, 215, 0, 0.8);
            margin-bottom: 10px;
          "
        >
          ILHA CONQUISTADA
        </div>
        <p
          id="victoryRewardTxt"
          style="color: #00ff66; font-size: 20px; margin-bottom: 24px"
        >
          +0 NatashaCoins creditadas
        </p>
        <button class="menu-wood-btn" id="victoryBtn">JOGAR DE NOVO</button>
      </div>
    </div>

    <script>
      const canvas = document.getElementById("gameCanvas");
      const ctx = canvas.getContext("2d");

      const V_WIDTH = 640;
      const V_HEIGHT = 360;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        ctx.imageSmoothingEnabled = false;
      }
      window.addEventListener("resize", resize);
      resize();

      const menuScreen = document.getElementById("menuScreen");
      const touchControls = document.getElementById("touchControls");
      const gameOverModal = document.getElementById("gameOverModal");
      const victoryModal = document.getElementById("victoryModal");
      const pauseModal = document.getElementById("pauseModal");
      const pauseBtn = document.getElementById("pauseBtn");
      const muteBtn = document.getElementById("muteBtn");
      const btnPlay = document.getElementById("btnPlay");
      const restartBtn = document.getElementById("restartBtn");
      const victoryBtn = document.getElementById("victoryBtn");
      const resumeBtn = document.getElementById("resumeBtn");
      const rewardTxt = document.getElementById("rewardTxt");
      const victoryRewardTxt = document.getElementById("victoryRewardTxt");

      const urlParams = new URLSearchParams(window.location.search);
      const discordUserId = urlParams.get("userId") || "guest";

      // ------------------------------------------------------------------
      // CARREGAMENTO DE SPRITES + DETECÇÃO AUTOMÁTICA DE ÁREA VISÍVEL
      // ------------------------------------------------------------------
      // Isso resolve o bug do personagem "flutuando": em vez de confiar em
      // deslocamentos fixos (offsets manuais tipo "-8px"), cada imagem é
      // analisada assim que carrega para descobrir onde o desenho realmente
      // começa e termina (ignorando a margem transparente do PNG). Assim,
      // ao desenhar, sempre alinhamos os PÉS do sprite com a base da hitbox,
      // não importa quanta margem cada frame (Idle, Run, Jump, Fall, Hit) tenha.
      function analyzeSprite(img) {
        try {
          const w = img.naturalWidth,
            h = img.naturalHeight;
          if (!w || !h) return;
          const c = document.createElement("canvas");
          c.width = w;
          c.height = h;
          const cctx = c.getContext("2d");
          cctx.drawImage(img, 0, 0);
          const data = cctx.getImageData(0, 0, w, h).data;
          let minX = w,
            maxX = -1,
            minY = h,
            maxY = -1;
          for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
              if (data[(y * w + x) * 4 + 3] > 12) {
                if (x < minX) minX = x;
                if (x > maxX) maxX = x;
                if (y < minY) minY = y;
                if (y > maxY) maxY = y;
              }
            }
          }
          if (maxX < 0) {
            minX = 0;
            maxX = w - 1;
            minY = 0;
            maxY = h - 1;
          }
          img._bounds = { minX, maxX, minY, maxY };
        } catch (e) {
          // Se a imagem estiver bloqueada por CORS, cai para o tamanho cheio.
          img._bounds = {
            minX: 0,
            maxX: (img.naturalWidth || 1) - 1,
            minY: 0,
            maxY: (img.naturalHeight || 1) - 1,
          };
        }
      }

      // Se um asset não carregar (nome de pasta/arquivo diferente do real),
      // ele NÃO trava o jogo — mas agora avisa no console com o caminho exato
      // que faltou, então dá pra achar rapidamente o que precisa ser corrigido
      // (antes ele só virava um quadrado colorido sem nenhuma pista do motivo).
      const missingAssets = new Set();
      function loadImg(file) {
        const img = new Image();
        const path = "/plataforma/assets/" + file;
        img.onload = () => analyzeSprite(img);
        img.onerror = () => {
          if (!missingAssets.has(path)) {
            missingAssets.add(path);
            console.warn("[Pirate Adventure] sprite não encontrado:", path);
          }
        };
        img.src = encodeURI(path);
        return img;
      }

      // Desenha uma imagem alinhando o CENTRO horizontal e a BASE (pés) a um
      // ponto de ancoragem (centerX, bottomY) no mundo do jogo. flip espelha.
      function drawAnchored(img, centerX, bottomY, flip) {
        if (!img || !img.complete || !img.naturalWidth) return;
        const b = img._bounds || {
          minX: 0,
          maxX: img.naturalWidth - 1,
          minY: 0,
          maxY: img.naturalHeight - 1,
        };
        const contentCenterX = (b.minX + b.maxX) / 2;
        const footY = b.maxY + 1;
        const drawY = bottomY - footY;
        ctx.save();
        if (flip) {
          ctx.translate(centerX, drawY);
          ctx.scale(-1, 1);
          ctx.drawImage(img, -contentCenterX, 0);
        } else {
          ctx.drawImage(img, centerX - contentCenterX, drawY);
        }
        ctx.restore();
      }

      // ------------------------------------------------------------------
      // FALLBACK "PIXEL ART" PARA INIMIGOS
      // ------------------------------------------------------------------
      // Enquanto os sprites reais de Inimigos/... não carregam (ex: nome de
      // pasta diferente do esperado — veja o aviso no console vindo de
      // loadImg), em vez de cair num quadrado colorido sem graça, desenhamos
      // um "bichinho" simples só com blocos, no espírito pixel art do resto
      // do jogo. Assim que o sprite real carregar, ele passa a ser usado
      // automaticamente (essa função só entra quando validFrames.length===0).
      const ENEMY_SPRITES = {
        crab: {
          grid: [
            "........",
            "..a..a..",
            "..b..b..",
            "c222222c",
            "d222222d",
            ".e.e.e.e",
            "........",
            "........",
          ],
          colors: {
            a: "#f0866d",
            b: "#c23e2b",
            c: "#9c2f20",
            d: "#c23e2b",
            2: "#e6533c",
            e: "#4a1710",
          },
          eyes: [
            [2.5, 1.5],
            [5.5, 1.5],
          ],
        },
        star: {
          grid: [
            "...11...",
            "..1111..",
            ".111111.",
            "11111111",
            "11111111",
            ".111111.",
            "..1111..",
            "...11...",
          ],
          colors: { 1: "#ec4899" },
          eyes: [
            [3, 3.4],
            [5, 3.4],
          ],
        },
        turret: {
          grid: [
            "........",
            "..2222..",
            ".222222.",
            "22222225",
            "22222225",
            "22222225",
            "11111111",
            "........",
          ],
          colors: { 2: "#9ca3af", 5: "#3f3f46", 1: "#57534e" },
          eyes: [],
        },
      };

      function drawPixelMonster(type, x, y, w, h, flip) {
        const spec = ENEMY_SPRITES[type];
        if (!spec) return;
        const rows = spec.grid;
        const cols = rows[0].length;
        const cw = w / cols;
        const rh = h / rows.length;
        ctx.save();
        if (flip) {
          ctx.translate(x + w, y);
          ctx.scale(-1, 1);
        } else {
          ctx.translate(x, y);
        }
        for (let ry = 0; ry < rows.length; ry++) {
          const row = rows[ry];
          for (let rx = 0; rx < cols; rx++) {
            const key = row[rx];
            if (key === ".") continue;
            ctx.fillStyle = spec.colors[key] || "#999";
            ctx.fillRect(
              Math.floor(rx * cw),
              Math.floor(ry * rh),
              Math.ceil(cw) + 1,
              Math.ceil(rh) + 1,
            );
          }
        }
        (spec.eyes || []).forEach(([ex, ey]) => {
          const px = ex * cw,
            py = ey * rh;
          ctx.fillStyle = "#fff";
          ctx.beginPath();
          ctx.arc(px, py, cw * 0.36, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = "#111";
          ctx.beginPath();
          ctx.arc(px + cw * 0.1, py, cw * 0.16, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.restore();
      }

      // Carrega uma sequência de frames de uma pasta. Aceita os dois padrões
      // de nome usados nos assets: "01.png" (prefix vazio) ou "Idle 01.png"
      // (prefix + espaço + número). Frames que não existirem na pasta
      // simplesmente não completam o carregamento e são ignorados nos loops
      // de animação (ver `validFrames` mais abaixo) — então é seguro pedir
      // "frames a mais" caso a contagem real varie.
      function loadSequence(folder, prefix, count, ext = ".png") {
        const arr = [];
        for (let i = 1; i <= count; i++) {
          const num = String(i).padStart(2, "0");
          const name = prefix ? `${prefix} ${num}${ext}` : `${num}${ext}`;
          arr.push(loadImg(`${folder}/${name}`));
        }
        return arr;
      }

      // Cenário
      const imgSky = loadImg("Additional Sky.png");
      const imgWater = loadImg("Additional Water.png");
      const imgClouds = loadImg("Big Clouds.png");
      const animWaterReflect = [
        loadImg("Water Reflect 01.png"),
        loadImg("Water Reflect 02.png"),
        loadImg("Water Reflect 03.png"),
        loadImg("Water Reflect 04.png"),
      ];

      // Palmeiras Animadas
      const animPalm = [
        loadImg("Back Palm Tree Regular 01.png"),
        loadImg("Back Palm Tree Regular 02.png"),
        loadImg("Back Palm Tree Regular 03.png"),
        loadImg("Back Palm Tree Regular 04.png"),
      ];

      const imgTerrain = loadImg("Terrain (32x32).png");

      // Jogador Pirata
      const animIdle = [
        loadImg("Idle 01.png"),
        loadImg("Idle 02.png"),
        loadImg("Idle 03.png"),
        loadImg("Idle 04.png"),
        loadImg("Idle 05.png"),
      ];
      const animRun = [
        loadImg("Run 01.png"),
        loadImg("Run 02.png"),
        loadImg("Run 03.png"),
        loadImg("Run 04.png"),
        loadImg("Run 05.png"),
        loadImg("Run 06.png"),
      ];
      const animJump = [loadImg("Jump 01.png")];
      const animFall = [loadImg("Fall 01.png")];
      const animHit = [loadImg("Hit 01.png")];

      // ------------------------------------------------------------------
      // INIMIGOS (pastas reais: Inimigos/<nome>/<estado>/<frame>)
      // ------------------------------------------------------------------
      // Caranguejo — só tem a animação "Correndo" (anda de um lado a outro)
      const animCrabRun = loadSequence(
        "Inimigos/caranguejo/Correndo",
        "Run",
        6,
      );

      // Atirador — fica Parado (1 frame) e dispara com a animação de Ataque (6 frames)
      const animShooterIdle = loadSequence("Inimigos/Atirador/Parado", "", 1);
      const animShooterAttack = loadSequence("Inimigos/Atirador/Ataque", "", 6);

      // Inimigo 2 (estrela) — Parado / Pulando / Caindo. Pula em direção ao jogador.
      const animStarIdle = loadSequence("Inimigos/Inimigo 2/Parado", "Idle", 8);
      const animStarJump = loadSequence(
        "Inimigos/Inimigo 2/Pulando",
        "Jump",
        3,
      );
      const animStarFall = loadSequence("Inimigos/Inimigo 2/Caindo", "Fall", 1);

      // Efeito caveira — animação de impacto usada quando um inimigo morre
      const animSkullEffect = loadSequence("Inimigos/Efeito caveira", "", 5);

      // ------------------------------------------------------------------
      // ITENS (pastas reais: Itens/<nome>)
      // ------------------------------------------------------------------
      // OBS: se a contagem real de frames de alguma pasta abaixo for diferente,
      // é só ajustar o número — frames que não existirem são ignorados sozinhos.
      const animGoldenSkull = loadSequence("Itens/Golden Skull", "", 8); // aumenta o HP máximo
      const animGreenBottle = loadSequence("Itens/Green Bottle", "", 7); // cura total
      const animRedPotion = loadSequence("Itens/Red Potion", "", 7); // recupera 1 HP
      const animGoldCoin = loadSequence("Itens/Gold Coin", "", 6); // moeda (NatashaCoins)
      const animCoinEffect = loadSequence("Itens/Coin Effect", "", 6); // partícula ao coletar moeda
      const animPotionEffect = loadSequence("Itens/Potion Effect", "", 6); // partícula ao coletar poção

      // HUD (assets próprios da pasta assets/hud)
      const imgAvatarPirate = loadImg("hud/avatar_pirata.png");
      const imgHeart = loadImg("hud/coracao_barra.png");
      const imgHeartEmpty = loadImg("hud/coracao_base.png");

      // ------------------------------------------------------------------
      // MÚSICA
      // ------------------------------------------------------------------
      function makeTrack(src) {
        const audio = new Audio();
        audio.preload = "auto";
        audio.src = encodeURI(src);
        audio.loop = true;
        audio.volume = 0.5;
        audio.muted = false;
        return audio;
      }

      const musicMenu = makeTrack("/plataforma/Musicas/bgm_menu.mp3");
      const actionTracks = [1, 2, 3, 4, 5].map((n) =>
        makeTrack(`/plataforma/Musicas/bgm_action_${n}.mp3`),
      );
      let currentActionTrack = null;
      let musicMuted = false;
      let audioUnlocked = false;

      function unlockAudio() {
        if (audioUnlocked) return;
        audioUnlocked = true;
        if (gameState === "MENU") safePlay(musicMenu);
        else if (gameState === "PLAYING" && currentActionTrack)
          safePlay(currentActionTrack);
      }

      function safePlay(audio) {
        if (!audio || musicMuted) return;
        const playPromise = audio.play();
        if (playPromise && playPromise.catch) {
          playPromise.catch(() => {});
        }
      }
      function stopActionMusic() {
        actionTracks.forEach((a) => a.pause());
        currentActionTrack = null;
      }
      function playMenuMusic() {
        stopActionMusic();
        musicMenu.currentTime = 0;
        safePlay(musicMenu);
      }
      function stopMenuMusic() {
        musicMenu.pause();
      }
      function playRandomActionMusic() {
        unlockAudio();
        stopMenuMusic();
        currentActionTrack =
          actionTracks[Math.floor(Math.random() * actionTracks.length)];
        currentActionTrack.currentTime = 0;
        safePlay(currentActionTrack);
      }
      function pauseAllMusic() {
        musicMenu.pause();
        actionTracks.forEach((a) => a.pause());
      }
      function resumeMusic() {
        if (gameState === "PLAYING") {
          if (currentActionTrack) safePlay(currentActionTrack);
        } else {
          safePlay(musicMenu);
        }
      }
      // Navegadores bloqueiam áudio automático sem interação — tenta desbloquear no primeiro clique/tecla.
      document.addEventListener("pointerdown", unlockAudio, { once: true });
      document.addEventListener("keydown", unlockAudio, { once: true });

      // ------------------------------------------------------------------
      // SFX RETRÔ SINTETIZADOS (Web Audio API)
      // ------------------------------------------------------------------
      // Não depende de nenhum arquivo de áudio extra: cada efeito (pulo,
      // moeda, dano, vitória, clique de botão...) é sintetizado na hora com
      // osciladores simples, no estilo "bleep" de 8-bit. Respeita o mesmo
      // botão de mudo usado pela música (musicMuted).
      let sfxCtx = null;
      function getSfxCtx() {
        if (!sfxCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) sfxCtx = new AC();
        }
        if (sfxCtx && sfxCtx.state === "suspended") sfxCtx.resume();
        return sfxCtx;
      }

      function beep({
        freq = 440,
        end = freq,
        type = "square",
        duration = 0.12,
        volume = 0.16,
        delay = 0,
      }) {
        if (musicMuted) return;
        const ac = getSfxCtx();
        if (!ac) return;
        const t0 = ac.currentTime + delay;
        const osc = ac.createOscillator();
        const gain = ac.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, t0);
        osc.frequency.exponentialRampToValueAtTime(
          Math.max(1, end),
          t0 + duration,
        );
        gain.gain.setValueAtTime(volume, t0);
        gain.gain.exponentialRampToValueAtTime(0.001, t0 + duration);
        osc.connect(gain).connect(ac.destination);
        osc.start(t0);
        osc.stop(t0 + duration + 0.02);
      }

      const Sfx = {
        jump: () =>
          beep({ freq: 380, end: 720, duration: 0.14, type: "square" }),
        doubleJump: () =>
          beep({ freq: 500, end: 900, duration: 0.13, type: "triangle" }),
        coin: () => {
          beep({
            freq: 880,
            end: 880,
            duration: 0.05,
            type: "square",
            volume: 0.14,
          });
          beep({
            freq: 1320,
            end: 1320,
            duration: 0.12,
            type: "square",
            volume: 0.14,
            delay: 0.05,
          });
        },
        stomp: () =>
          beep({ freq: 260, end: 90, duration: 0.14, type: "sawtooth" }),
        hit: () =>
          beep({
            freq: 180,
            end: 60,
            duration: 0.22,
            type: "sawtooth",
            volume: 0.2,
          }),
        heal: () =>
          beep({
            freq: 500,
            end: 950,
            duration: 0.22,
            type: "sine",
            volume: 0.15,
          }),
        powerUp: () => {
          [520, 660, 780, 1040].forEach((f, i) =>
            beep({
              freq: f,
              end: f,
              duration: 0.09,
              type: "square",
              volume: 0.14,
              delay: i * 0.07,
            }),
          );
        },
        click: () =>
          beep({
            freq: 660,
            end: 500,
            duration: 0.06,
            type: "square",
            volume: 0.12,
          }),
        pause: () =>
          beep({
            freq: 440,
            end: 220,
            duration: 0.1,
            type: "triangle",
            volume: 0.12,
          }),
        gameOver: () => {
          [440, 370, 310, 220].forEach((f, i) =>
            beep({
              freq: f,
              end: f * 0.9,
              duration: 0.22,
              type: "sawtooth",
              volume: 0.16,
              delay: i * 0.18,
            }),
          );
        },
        victory: () => {
          [520, 660, 780, 1040, 1320].forEach((f, i) =>
            beep({
              freq: f,
              end: f,
              duration: 0.16,
              type: "square",
              volume: 0.15,
              delay: i * 0.12,
            }),
          );
        },
      };

      const enemyProjectiles = [];
      const particles = [];
      const floatingTexts = [];
      const effects = []; // animações de impacto (ex: Efeito caveira, Coin/Potion Effect)

      function spawnEffect(animArr, x, y, w, h, frameDuration = 4) {
        effects.push({
          anim: animArr,
          x,
          y,
          w,
          h,
          frame: 0,
          timer: 0,
          frameDuration,
        });
      }

      // ------------------------------------------------------------------
      // FÍSICA
      // ------------------------------------------------------------------
      const GRAVITY = 0.55;
      const MAX_FALL = 11;
      const MAX_SPEED = 3.6;
      const ACCEL = 0.45;
      const DECEL = 0.4;
      const JUMP_FORCE = -9.6;
      const DOUBLE_JUMP_FORCE = -8.2;
      const COYOTE_FRAMES = 6; // permite pular por alguns frames após sair da borda
      const JUMP_BUFFER_FRAMES = 8; // guarda o "pulo" apertado um pouco antes de tocar o chão

      let gameState = "MENU"; // MENU | PLAYING | PAUSED | GAMEOVER
      let hp = 3,
        maxHp = 3,
        lives = 3,
        coinsCollected = 0;
      const MAX_HP_CAP = 6; // limite de corações que a Golden Skull pode dar
      let doubleJumpAvailable = true;
      let invulnerableTimer = 0;
      let coyoteTimer = 0;
      let jumpBufferTimer = 0;
      let cameraX = 0;
      let cloudsX = 0;
      let waterFrame = 0,
        waterTimer = 0;
      let palmFrame = 0,
        palmTimer = 0;
      let shakeTimer = 0,
        shakeMag = 0;
      let squash = 1; // escala vertical p/ efeito de "squash & stretch"

      const keys = { l: false, r: false };

      // Jogador (hitbox de colisão — o desenho é alinhado a partir dela, não o contrário)
      const player = {
        x: 64,
        y: 236,
        w: 22,
        h: 24,
        vx: 0,
        vy: 0,
        onGround: false,
        wasOnGround: false,
        facingLeft: false,
        state: "idle",
        frame: 0,
        frameTimer: 0,
      };

      // Plataformas
      const platforms = [
        { x: 0, y: 260, w: 576, h: 100 },
        { x: 640, y: 260, w: 384, h: 100 },
        { x: 1088, y: 228, w: 416, h: 132 },
        { x: 1568, y: 260, w: 640, h: 100 },
      ];
      const LEVEL_WIDTH = Math.max(...platforms.map((p) => p.x + p.w));

      // Mastro de chegada estilo Mario: alcançar essa marca vence a fase.
      const flagPole = {
        x: LEVEL_WIDTH - 90,
        baseY: 260,
        height: 120,
        reached: false,
      };

      // Inimigos no chão
      const initialEnemies = [
        {
          type: "crab",
          x: 280,
          y: 236,
          w: 34,
          h: 24,
          vx: 1.2,
          minX: 180,
          maxX: 480,
        },
        { type: "star", x: 700, y: 236, w: 28, h: 28, hopTimer: 60 },
        { type: "turret", x: 900, y: 236, w: 28, h: 28 },
        {
          type: "crab",
          x: 1200,
          y: 204,
          w: 34,
          h: 24,
          vx: 1.4,
          minX: 1100,
          maxX: 1380,
        },
        { type: "star", x: 1420, y: 236, w: 28, h: 28, hopTimer: 90 },
      ];
      let enemies = [];

      const initialItems = [
        {
          type: "potion_red",
          x: 220,
          y: 236,
          w: 18,
          h: 18,
          anim: animRedPotion,
        },
        {
          type: "potion_green",
          x: 480,
          y: 236,
          w: 18,
          h: 18,
          anim: animGreenBottle,
        },
        { type: "coin", x: 560, y: 236, w: 16, h: 16, anim: animGoldCoin },
        { type: "coin", x: 600, y: 236, w: 16, h: 16, anim: animGoldCoin },
        {
          type: "potion_green",
          x: 820,
          y: 236,
          w: 18,
          h: 18,
          anim: animGreenBottle,
        },
        {
          type: "golden_skull",
          x: 1280,
          y: 190,
          w: 22,
          h: 22,
          anim: animGoldenSkull,
        },
      ];
      let items = [];

      function spawnParticles(x, y, count, color, spread = 2, life = 24) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x,
            y,
            vx: (Math.random() - 0.5) * spread * 2,
            vy: -Math.random() * spread - 0.5,
            life,
            maxLife: life,
            color,
          });
        }
      }

      function spawnFloatingText(x, y, text, color) {
        floatingTexts.push({ x, y, text, color, life: 45, maxLife: 45 });
      }

      // Poeira dourada flutuante no menu — só um toque de "vida" na tela de
      // título, parado quando o jogo começa.
      const menuSparkles = [];
      function updateMenuSparkles() {
        if (Math.random() < 0.06) {
          menuSparkles.push({
            x: Math.random() * V_WIDTH,
            y: V_HEIGHT + 6,
            vy: -0.3 - Math.random() * 0.35,
            vx: (Math.random() - 0.5) * 0.15,
            life: 280,
            maxLife: 280,
            size: 1 + Math.random() * 1.4,
          });
        }
        for (let i = menuSparkles.length - 1; i >= 0; i--) {
          const s = menuSparkles[i];
          s.x += s.vx;
          s.y += s.vy;
          s.life--;
          if (s.life <= 0 || s.y < -10) menuSparkles.splice(i, 1);
        }
      }

      function screenShake(mag, duration) {
        shakeMag = mag;
        shakeTimer = duration;
      }

      function resetPlayer() {
        player.x = 64;
        player.y = 236;
        player.vx = 0;
        player.vy = 0;
        player.onGround = false;
        invulnerableTimer = 60;
      }

      function takeDamage() {
        if (invulnerableTimer > 0) return;
        hp--;
        invulnerableTimer = 90;
        player.vy = -5;
        player.vx = player.facingLeft ? 4.5 : -4.5;
        player.state = "hit";
        screenShake(4, 14);
        Sfx.hit();
        spawnParticles(
          player.x + player.w / 2,
          player.y + player.h / 2,
          8,
          "#ff0055",
          3,
          30,
        );

        if (hp <= 0) {
          lives--;
          if (lives <= 0) {
            triggerGameOver();
          } else {
            hp = maxHp;
            resetPlayer();
          }
        }
      }

      async function triggerGameOver() {
        gameState = "GAMEOVER";
        gameOverModal.classList.remove("hidden");
        pauseBtn.classList.add("hidden");
        muteBtn.classList.add("hidden");
        stopActionMusic();
        playMenuMusic();
        Sfx.gameOver();
        const earnedCoins = coinsCollected * 20;
        rewardTxt.textContent = `+${earnedCoins} NatashaCoins creditadas`;

        if (discordUserId !== "guest" && earnedCoins > 0) {
          try {
            await fetch("/api/score", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                userId: discordUserId,
                score: coinsCollected,
              }),
            });
          } catch (e) {}
        }
      }

      async function triggerVictory() {
        gameState = "VICTORY";
        victoryModal.classList.remove("hidden");
        pauseBtn.classList.add("hidden");
        muteBtn.classList.add("hidden");
        stopActionMusic();
        playMenuMusic();
        Sfx.victory();
        screenShake(3, 20);
        spawnParticles(
          flagPole.x,
          flagPole.baseY - flagPole.height,
          30,
          "#ffd700",
          4,
          50,
        );

        const bonus = 10; // bônus por concluir a fase, estilo bandeira do Mario
        const earnedCoins = coinsCollected * 20 + bonus;
        victoryRewardTxt.textContent = `+${earnedCoins} NatashaCoins creditadas`;

        if (discordUserId !== "guest" && earnedCoins > 0) {
          try {
            await fetch("/api/score", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                userId: discordUserId,
                score: coinsCollected + bonus,
              }),
            });
          } catch (e) {}
        }
      }

      function handleJump() {
        jumpBufferTimer = JUMP_BUFFER_FRAMES;
      }

      function tryConsumeJumpBuffer() {
        if (jumpBufferTimer <= 0) return;
        if (player.onGround || coyoteTimer > 0) {
          player.vy = JUMP_FORCE;
          player.onGround = false;
          coyoteTimer = 0;
          jumpBufferTimer = 0;
          squash = 1.25;
          Sfx.jump();
          spawnParticles(
            player.x + player.w / 2,
            player.y + player.h,
            6,
            "#ffffff",
            1.5,
            16,
          );
        } else if (doubleJumpAvailable) {
          player.vy = DOUBLE_JUMP_FORCE;
          doubleJumpAvailable = false;
          jumpBufferTimer = 0;
          squash = 1.3;
          Sfx.doubleJump();
          spawnParticles(
            player.x + player.w / 2,
            player.y + player.h / 2,
            10,
            "#38bdf8",
            2,
            20,
          );
        }
      }

      function update() {
        cloudsX = (cloudsX + 0.2) % 440;

        waterTimer++;
        if (waterTimer % 8 === 0) waterFrame = (waterFrame + 1) % 4;

        palmTimer++;
        if (palmTimer % 12 === 0) palmFrame = (palmFrame + 1) % 4;

        // partículas e textos flutuantes seguem animando mesmo fora do PLAYING (visual)
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.15;
          p.life--;
          if (p.life <= 0) particles.splice(i, 1);
        }
        for (let i = floatingTexts.length - 1; i >= 0; i--) {
          const t = floatingTexts[i];
          t.y -= 0.5;
          t.life--;
          if (t.life <= 0) floatingTexts.splice(i, 1);
        }
        if (shakeTimer > 0) shakeTimer--;
        squash += (1 - squash) * 0.2;

        if (gameState === "MENU") updateMenuSparkles();

        if (gameState !== "PLAYING") return;

        if (invulnerableTimer > 0) invulnerableTimer--;
        if (coyoteTimer > 0) coyoteTimer--;
        if (jumpBufferTimer > 0) jumpBufferTimer--;

        if (keys.l) {
          player.vx = Math.max(player.vx - ACCEL, -MAX_SPEED);
          player.facingLeft = true;
        } else if (keys.r) {
          player.vx = Math.min(player.vx + ACCEL, MAX_SPEED);
          player.facingLeft = false;
        } else {
          if (player.vx > 0) player.vx = Math.max(0, player.vx - DECEL);
          else if (player.vx < 0) player.vx = Math.min(0, player.vx + DECEL);
        }

        // guarda a posição anterior ANTES de mover — é isso que resolve o
        // atravessar-o-chão em quedas rápidas e o "grudar" nas bordas.
        const prevBottom = player.y + player.h;

        // --- Colisão horizontal ---
        player.x += player.vx;
        platforms.forEach((p) => {
          const meaningfulOverlap =
            player.y + player.h > p.y + 6 && player.y < p.y + p.h;
          if (
            meaningfulOverlap &&
            player.x + player.w > p.x &&
            player.x < p.x + p.w
          ) {
            if (player.vx > 0) player.x = p.x - player.w;
            else if (player.vx < 0) player.x = p.x + p.w;
            player.vx = 0;
          }
        });
        player.x = Math.max(0, Math.min(player.x, LEVEL_WIDTH - player.w));

        // --- Colisão vertical (plataforma de mão única, sem tunneling) ---
        player.vy = Math.min(player.vy + GRAVITY, MAX_FALL);
        player.y += player.vy;
        player.wasOnGround = player.onGround;
        player.onGround = false;

        platforms.forEach((p) => {
          const withinX =
            player.x + player.w > p.x + 2 && player.x < p.x + p.w - 2;
          const cameFromAbove = prevBottom <= p.y + 1;
          const nowInsideOrBelow = player.y + player.h >= p.y;
          if (withinX && cameFromAbove && player.vy >= 0 && nowInsideOrBelow) {
            player.y = p.y - player.h;
            player.vy = 0;
            player.onGround = true;
            doubleJumpAvailable = true;
          }
        });

        if (player.onGround && !player.wasOnGround) {
          squash = 0.7;
          spawnParticles(
            player.x + player.w / 2,
            player.y + player.h,
            5,
            "#e8e8e8",
            1.2,
            14,
          );
        }
        if (!player.onGround && player.wasOnGround) {
          coyoteTimer = COYOTE_FRAMES;
        }

        tryConsumeJumpBuffer();

        if (player.y > 380) {
          takeDamage();
          resetPlayer();
        }

        if (invulnerableTimer > 60) player.state = "hit";
        else if (!player.onGround)
          player.state = player.vy < 0 ? "jump" : "fall";
        else if (Math.abs(player.vx) > 0.3) player.state = "run";
        else player.state = "idle";

        player.frameTimer++;
        if (player.frameTimer % 5 === 0) player.frame++;

        // --- Inimigos ---
        enemies.forEach((e) => {
          if (e.dead) return;
          const enemyPrevBottom = e.y + e.h;

          if (e.type === "crab") {
            e.x += e.vx;
            if (e.x <= e.minX || e.x >= e.maxX) e.vx *= -1;
            e.facingLeft = e.vx < 0;
          } else if (e.type === "star") {
            // Estrela saltitante: fica Parada, e de tempos em tempos pula na
            // direção do jogador (Parado -> Pulando -> Caindo -> Parado...).
            e.vy = e.vy || 0;
            e.vx = e.vx || 0;
            e.onGround = e.onGround || false;
            e.hopTimer = (e.hopTimer !== undefined ? e.hopTimer : 60) - 1;

            if (e.onGround) {
              e.vx *= 0.8;
              if (e.hopTimer <= 0) {
                const dir = player.x < e.x ? -1 : 1;
                e.vx = dir * 1.7;
                e.vy = -7.5;
                e.onGround = false;
                e.hopTimer = 70 + Math.floor(Math.random() * 40);
              }
            }

            e.vy = Math.min(e.vy + GRAVITY, MAX_FALL);
            e.x += e.vx;
            e.y += e.vy;

            const wasOnGround = e.onGround;
            e.onGround = false;
            platforms.forEach((p) => {
              const withinX = e.x + e.w > p.x + 2 && e.x < p.x + p.w - 2;
              if (
                withinX &&
                e.vy >= 0 &&
                e.y + e.h >= p.y &&
                e.y + e.h - e.vy <= p.y + 2
              ) {
                e.y = p.y - e.h;
                e.vy = 0;
                e.onGround = true;
              }
            });

            e.facingLeft = e.vx < 0;
            e.hopState = !e.onGround ? (e.vy < 0 ? "jump" : "fall") : "idle";
          } else if (e.type === "turret") {
            // Atirador: fica Parado e periodicamente faz a animação de Ataque,
            // disparando um projétil na metade da animação.
            e.shootTimer = (e.shootTimer || 0) + 1;
            if (!e.attacking && e.shootTimer >= 150) {
              e.attacking = true;
              e.attackFrame = 0;
              e.shootTimer = 0;
            }
            if (e.attacking) {
              e.attackFrame++;
              if (e.attackFrame === 18) {
                const dir = player.x < e.x ? -1 : 1;
                enemyProjectiles.push({
                  x: e.x + e.w / 2,
                  y: e.y + e.h / 2,
                  vx: dir * 3.5,
                  r: 5,
                });
              }
              if (e.attackFrame > 34) e.attacking = false;
            }
            e.facingLeft = player.x < e.x;
          }

          const overlapping =
            player.x + player.w > e.x + 4 &&
            player.x < e.x + e.w - 4 &&
            player.y + player.h > e.y + 4 &&
            player.y < e.y + e.h;

          if (overlapping) {
            const stomping =
              player.vy > 0 &&
              prevBottom <= enemyPrevBottom + 8 &&
              e.type !== "turret";
            if (stomping) {
              e.dead = true;
              player.vy = JUMP_FORCE * 0.7;
              coinsCollected += 2;
              Sfx.stomp();
              spawnEffect(
                animSkullEffect,
                e.x + e.w / 2 - 16,
                e.y + e.h / 2 - 16,
                32,
                32,
                5,
              );
              spawnFloatingText(e.x + e.w / 2, e.y, "+2", "#ffd700");
            } else {
              takeDamage();
            }
          }
        });

        // --- Projéteis ---
        for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
          const pr = enemyProjectiles[i];
          pr.x += pr.vx;

          if (
            pr.x > player.x &&
            pr.x < player.x + player.w &&
            pr.y > player.y &&
            pr.y < player.y + player.h
          ) {
            takeDamage();
            enemyProjectiles.splice(i, 1);
            continue;
          }

          if (pr.x < cameraX - 50 || pr.x > cameraX + V_WIDTH + 50) {
            enemyProjectiles.splice(i, 1);
          }
        }

        // --- Efeitos animados (impacto, coleta) ---
        for (let i = effects.length - 1; i >= 0; i--) {
          const fx = effects[i];
          fx.timer++;
          if (fx.timer % fx.frameDuration === 0) fx.frame++;
          if (fx.frame >= fx.anim.length) effects.splice(i, 1);
        }

        // --- Itens ---
        items.forEach((it) => {
          if (it.collected) return;
          if (
            player.x + player.w > it.x &&
            player.x < it.x + it.w &&
            player.y + player.h > it.y &&
            player.y < it.y + it.h
          ) {
            it.collected = true;

            if (it.type === "coin") {
              coinsCollected++;
              Sfx.coin();
              spawnFloatingText(it.x + it.w / 2, it.y, "+1", "#ffd700");
              spawnEffect(
                animCoinEffect,
                it.x + it.w / 2 - 16,
                it.y + it.h / 2 - 16,
                32,
                32,
                4,
              );
              // rastro de brilho dourado ao coletar (sensação "premium")
              spawnParticles(
                it.x + it.w / 2,
                it.y + it.h / 2,
                6,
                "#ffe066",
                2,
                20,
              );
            } else if (it.type === "potion_red") {
              if (hp < maxHp) hp++;
              Sfx.heal();
              spawnFloatingText(it.x + it.w / 2, it.y, "+1 HP", "#ff5577");
              spawnEffect(
                animPotionEffect,
                it.x + it.w / 2 - 16,
                it.y + it.h / 2 - 16,
                32,
                32,
                4,
              );
            } else if (it.type === "potion_green") {
              hp = maxHp;
              Sfx.heal();
              spawnFloatingText(it.x + it.w / 2, it.y, "HP CHEIO", "#00ff66");
              spawnEffect(
                animPotionEffect,
                it.x + it.w / 2 - 16,
                it.y + it.h / 2 - 16,
                32,
                32,
                4,
              );
            } else if (it.type === "golden_skull") {
              if (maxHp < MAX_HP_CAP) maxHp++;
              hp = maxHp;
              Sfx.powerUp();
              spawnFloatingText(it.x + it.w / 2, it.y, "+1 HP MÁX!", "#ffd700");
              spawnEffect(
                animSkullEffect,
                it.x + it.w / 2 - 16,
                it.y + it.h / 2 - 16,
                32,
                32,
                5,
              );
            }
          }
        });

        if (!flagPole.reached && player.x + player.w >= flagPole.x) {
          flagPole.reached = true;
          triggerVictory();
        }

        cameraX = Math.max(
          0,
          Math.min(player.x - V_WIDTH * 0.35, LEVEL_WIDTH - V_WIDTH),
        );
      }

      function draw() {
        const scale = Math.max(
          canvas.width / V_WIDTH,
          canvas.height / V_HEIGHT,
        );
        const offsetX = (canvas.width - V_WIDTH * scale) / 2;
        const offsetY = (canvas.height - V_HEIGHT * scale) / 2;

        let shakeX = 0,
          shakeY = 0;
        if (shakeTimer > 0) {
          shakeX = (Math.random() - 0.5) * shakeMag;
          shakeY = (Math.random() - 0.5) * shakeMag;
        }

        ctx.save();
        ctx.translate(offsetX + shakeX, offsetY + shakeY);
        ctx.scale(scale, scale);

        // 1. Céu
        if (imgSky.complete && imgSky.naturalWidth > 0) {
          ctx.drawImage(imgSky, 0, 0, V_WIDTH, 200);
        } else {
          ctx.fillStyle = "#fce2c4";
          ctx.fillRect(0, 0, V_WIDTH, 200);
        }

        // 2. Nuvens
        if (imgClouds.complete && imgClouds.naturalWidth > 0) {
          const cx = (cloudsX - cameraX * 0.08) % 440;
          ctx.drawImage(imgClouds, cx - 440, 105, 440, 95);
          ctx.drawImage(imgClouds, cx, 105, 440, 95);
          ctx.drawImage(imgClouds, cx + 440, 105, 440, 95);
          ctx.drawImage(imgClouds, cx + 880, 105, 440, 95);
        }

        // 3. Mar — com ondulação real na superfície (deixa a água "viva" em
        // vez de uma textura estática esticada) e uma crista de luz seguindo
        // a onda.
        const waterTopY = 200;
        const waveClock = Date.now() / 500;
        if (imgWater.complete && imgWater.naturalWidth > 0) {
          const iw = imgWater.naturalWidth,
            ih = imgWater.naturalHeight;
          const sliceW = 16;
          for (let sx = 0; sx < V_WIDTH; sx += sliceW) {
            const dw = Math.min(sliceW, V_WIDTH - sx);
            const offsetY = Math.sin(waveClock + sx * 0.06) * 2.5;
            ctx.drawImage(
              imgWater,
              sx * (iw / V_WIDTH),
              0,
              iw * (dw / V_WIDTH),
              ih,
              sx,
              waterTopY + offsetY,
              dw,
              160,
            );
            ctx.fillStyle = "rgba(255,255,255,0.22)";
            ctx.fillRect(sx, waterTopY + offsetY - 1, dw, 2);
          }
        } else {
          ctx.fillStyle = "#6599b8";
          ctx.fillRect(0, waterTopY, V_WIDTH, 160);
        }

        // 4. Reflexo da água
        const curReflect = animWaterReflect[waterFrame];
        if (curReflect && curReflect.complete && curReflect.naturalWidth > 0) {
          const rw = curReflect.naturalWidth;
          const rh = curReflect.naturalHeight;
          for (let rx = -rw; rx < V_WIDTH + rw; rx += rw) {
            ctx.drawImage(
              curReflect,
              rx - ((cameraX * 0.15) % rw),
              195,
              rw,
              rh,
            );
          }
        }

        // 4b. Espuma animada na linha d'água + brilhos piscando na superfície
        ctx.save();
        ctx.globalAlpha = 0.55;
        ctx.fillStyle = "#ffffff";
        const foamSpacing = 34;
        const foamScroll = (cameraX * 0.2) % foamSpacing;
        for (
          let fx = -foamSpacing;
          fx < V_WIDTH + foamSpacing;
          fx += foamSpacing
        ) {
          const bob = Math.sin(waveClock * 1.3 + fx * 0.1) * 2;
          ctx.fillRect(fx - foamScroll, waterTopY + bob - 1, 14, 2);
        }
        for (let i = 0; i < 12; i++) {
          const sxg = (i * 71 + 20 - cameraX * 0.1) % (V_WIDTH + 80);
          const gx = sxg < 0 ? sxg + V_WIDTH + 80 : sxg;
          const gy = waterTopY + 18 + ((i * 53) % 130);
          const twinkle = (Math.sin(waveClock * 1.6 + i * 1.7) + 1) / 2;
          if (twinkle > 0.6) {
            ctx.globalAlpha = (twinkle - 0.6) * 2.4;
            ctx.fillStyle = "#e6faff";
            ctx.fillRect(gx, gy, 2, 2);
          }
        }
        ctx.restore();

        ctx.save();
        ctx.translate(-cameraX, 0);

        // 5. Palmeiras animadas
        const curPalm = animPalm[palmFrame];
        [80, 420, 800, 1240].forEach((px) => {
          if (curPalm && curPalm.complete && curPalm.naturalWidth > 0) {
            ctx.drawImage(curPalm, px, 132, 64, 128);
          }
        });

        // 6. Terreno da ilha
        const hasTerrain = imgTerrain.complete && imgTerrain.naturalWidth > 0;
        platforms.forEach((p) => {
          for (let bx = p.x; bx < p.x + p.w; bx += 32) {
            const isLeft = bx === p.x;
            const isRight = bx + 32 >= p.x + p.w;

            if (hasTerrain) {
              let sx = isLeft ? 0 : isRight ? 64 : 32;
              ctx.drawImage(imgTerrain, sx, 0, 32, 32, bx, p.y, 32, 32);
            } else {
              ctx.fillStyle = "#4ade80";
              ctx.fillRect(bx, p.y, 32, 8);
              ctx.fillStyle = "#b45309";
              ctx.fillRect(bx, p.y + 8, 32, 24);
            }

            for (let by = p.y + 32; by < p.y + p.h; by += 32) {
              if (hasTerrain) {
                let fillSx = isLeft ? 0 : isRight ? 64 : 32;
                ctx.drawImage(imgTerrain, fillSx, 32, 32, 32, bx, by, 32, 32);
              } else {
                ctx.fillStyle = "#78350f";
                ctx.fillRect(bx, by, 32, 32);
              }
            }
          }
        });

        // 6b. Mastro de chegada (bandeira estilo Mario, marca o fim da fase)
        {
          const poleX = flagPole.x;
          const poleTopY = flagPole.baseY - flagPole.height;
          ctx.save();
          ctx.fillStyle = "rgba(0,0,0,0.18)";
          ctx.beginPath();
          ctx.ellipse(poleX, flagPole.baseY + 4, 10, 4, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = "#e5e7eb";
          ctx.fillRect(poleX - 2, poleTopY, 4, flagPole.height);
          ctx.beginPath();
          ctx.arc(poleX, poleTopY, 5, 0, Math.PI * 2);
          ctx.fillStyle = "#ffd700";
          ctx.fill();

          const wave = Math.sin(Date.now() / 220) * 4;
          ctx.beginPath();
          ctx.moveTo(poleX + 2, poleTopY + 6);
          ctx.lineTo(poleX + 28 + wave, poleTopY + 14);
          ctx.lineTo(poleX + 2, poleTopY + 22);
          ctx.closePath();
          ctx.fillStyle = flagPole.reached ? "#ffd700" : "#111827";
          ctx.fill();
          ctx.strokeStyle = "#ffd700";
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(poleX + 13 + wave * 0.4, poleTopY + 14, 3, 0, Math.PI * 2);
          ctx.fillStyle = flagPole.reached ? "#111827" : "#f5f5f5";
          ctx.fill();
          ctx.restore();
        }

        // 7. Itens (poções, moedas, golden skull — cada um com sua animação real)
        items.forEach((it) => {
          if (it.collected) return;
          const validFrames = (it.anim || []).filter(
            (i) => i.complete && i.naturalWidth > 0,
          );
          if (validFrames.length > 0) {
            const frameImg =
              validFrames[Math.floor(Date.now() / 160) % validFrames.length];
            drawAnchored(frameImg, it.x + it.w / 2, it.y + it.h, false);
          } else {
            ctx.fillStyle =
              it.type === "coin"
                ? "#ffd700"
                : it.type === "golden_skull"
                  ? "#f5c518"
                  : "#22c55e";
            ctx.fillRect(it.x, it.y, it.w, it.h);
          }
        });

        // 8. Inimigos com aparência mais premium e menos quadrada
        enemies.forEach((e) => {
          if (e.dead) return;

          ctx.save();
          ctx.fillStyle = "rgba(0,0,0,0.18)";
          ctx.beginPath();
          ctx.ellipse(
            e.x + e.w / 2,
            e.y + e.h + 5,
            e.w * 0.55,
            5,
            0,
            0,
            Math.PI * 2,
          );
          ctx.fill();
          ctx.restore();

          let animArr,
            flip = !!e.facingLeft;

          if (e.type === "crab") {
            animArr = animCrabRun;
          } else if (e.type === "star") {
            animArr =
              e.hopState === "jump"
                ? animStarJump
                : e.hopState === "fall"
                  ? animStarFall
                  : animStarIdle;
          } else if (e.type === "turret") {
            animArr = e.attacking ? animShooterAttack : animShooterIdle;
          }

          const validFrames = (animArr || []).filter(
            (i) => i.complete && i.naturalWidth > 0,
          );

          if (validFrames.length > 0) {
            let frameImg;
            if (e.type === "turret" && e.attacking) {
              frameImg =
                validFrames[
                  Math.min(
                    validFrames.length - 1,
                    Math.floor(e.attackFrame / 6),
                  )
                ];
            } else {
              frameImg =
                validFrames[Math.floor(Date.now() / 140) % validFrames.length];
            }

            ctx.save();
            ctx.filter = "drop-shadow(0 0 6px rgba(255, 90, 90, 0.45))";
            drawAnchored(frameImg, e.x + e.w / 2, e.y + e.h, flip);
            ctx.restore();
          } else {
            ctx.save();
            ctx.shadowColor = "rgba(255,80,80,0.35)";
            ctx.shadowBlur = 8;
            drawPixelMonster(e.type, e.x, e.y, e.w, e.h, flip);
            ctx.restore();
          }
        });

        // 9. Projéteis
        enemyProjectiles.forEach((pr) => {
          ctx.fillStyle = "#ff0055";
          ctx.beginPath();
          ctx.arc(pr.x, pr.y, pr.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = "#fff";
          ctx.lineWidth = 1.5;
          ctx.stroke();
        });

        // 9b. Efeitos animados (impacto de morte, coleta de item)
        effects.forEach((fx) => {
          const frameImg = fx.anim[Math.min(fx.frame, fx.anim.length - 1)];
          if (frameImg && frameImg.complete && frameImg.naturalWidth > 0) {
            ctx.drawImage(frameImg, fx.x, fx.y, fx.w, fx.h);
          }
        });

        // 10. Pirata — alinhado dinamicamente pela base da hitbox (fix do bug de flutuar)
        if (invulnerableTimer % 6 < 3) {
          let animList = animIdle;
          if (player.state === "run") animList = animRun;
          else if (player.state === "jump") animList = animJump;
          else if (player.state === "fall") animList = animFall;
          else if (player.state === "hit") animList = animHit;

          const validFrames = animList.filter(
            (img) => img.complete && img.naturalWidth > 0,
          );
          const currentImg =
            validFrames.length > 0
              ? validFrames[player.frame % validFrames.length]
              : null;

          const centerX = player.x + player.w / 2;
          const bottomY = player.y + player.h;

          if (currentImg) {
            ctx.save();
            // squash & stretch leve, ancorado nos pés
            ctx.translate(centerX, bottomY);
            ctx.scale(1 / squash, squash);
            ctx.translate(-centerX, -bottomY);
            drawAnchored(currentImg, centerX, bottomY, player.facingLeft);
            ctx.restore();
          } else {
            ctx.fillStyle = "#ffcc00";
            ctx.fillRect(player.x, player.y, player.w, player.h);
          }
        }

        // 11. Partículas
        particles.forEach((p) => {
          ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
          ctx.fillStyle = p.color;
          ctx.fillRect(p.x - 1.5, p.y - 1.5, 3, 3);
          ctx.globalAlpha = 1;
        });

        // 12. Textos flutuantes (+1, +2...)
        floatingTexts.forEach((t) => {
          ctx.globalAlpha = Math.max(0, t.life / t.maxLife);
          ctx.fillStyle = t.color;
          ctx.font = "bold 12px ArcadeFont, monospace";
          ctx.textAlign = "center";
          ctx.fillText(t.text, t.x, t.y);
          ctx.globalAlpha = 1;
          ctx.textAlign = "left";
        });

        ctx.restore(); // fim do translate(-cameraX, 0)

        // 12b. Poeira dourada do menu (espaço virtual, não rola com a câmera)
        if (gameState === "MENU" && menuSparkles.length) {
          menuSparkles.forEach((s) => {
            ctx.globalAlpha = Math.min(1, s.life / 60) * 0.85;
            ctx.fillStyle = "#ffe066";
            ctx.fillRect(s.x, s.y, s.size, s.size);
          });
          ctx.globalAlpha = 1;
        }

        ctx.restore(); // fim do scale/offset da tela

        // 13. HUD limpo e premium, sem elementos flutuantes invasivos
        if (gameState === "PLAYING" || gameState === "PAUSED") {
          const leftX = 18;
          const leftY = 16;
          const avatarSize = 42;
          const panelW = 202;
          const panelH = 52;

          ctx.save();
          const leftGrad = ctx.createLinearGradient(
            leftX,
            leftY,
            leftX + panelW,
            leftY + panelH,
          );
          leftGrad.addColorStop(0, "rgba(22, 28, 35, 0.92)");
          leftGrad.addColorStop(1, "rgba(11, 15, 21, 0.92)");
          ctx.fillStyle = leftGrad;
          ctx.beginPath();
          ctx.roundRect(leftX, leftY, panelW, panelH, 12);
          ctx.fill();
          ctx.strokeStyle = "rgba(255, 210, 98, 0.9)";
          ctx.lineWidth = 1.6;
          ctx.stroke();

          ctx.beginPath();
          ctx.roundRect(leftX + 8, leftY + 8, avatarSize, avatarSize, 10);
          ctx.fillStyle = "rgba(255,255,255,0.06)";
          ctx.fill();
          ctx.clip();
          if (imgAvatarPirate.complete && imgAvatarPirate.naturalWidth > 0) {
            ctx.drawImage(
              imgAvatarPirate,
              leftX + 8,
              leftY + 8,
              avatarSize,
              avatarSize,
            );
          }
          ctx.restore();

          ctx.font = "bold 14px ArcadeFont, monospace";
          ctx.fillStyle = "rgba(220, 234, 255, 0.8)";
          ctx.fillText("HP", leftX + 64, leftY + 18);

          for (let i = 1; i <= maxHp; i++) {
            const heartX = leftX + 64 + (i - 1) * 18;
            const heartY = leftY + 24;
            const heartImg = i <= hp ? imgHeart : imgHeartEmpty;
            if (heartImg.complete && heartImg.naturalWidth > 0) {
              ctx.drawImage(heartImg, heartX, heartY, 14, 14);
            } else {
              ctx.fillStyle = i <= hp ? "#f87171" : "#374151";
              ctx.fillRect(heartX, heartY, 12, 12);
            }
          }

          const livesLabel = `Vidas ${lives}`;
          ctx.font = "bold 12px ArcadeFont, monospace";
          ctx.fillStyle = "#f8d764";
          ctx.fillText(livesLabel, leftX + 64, leftY + 46);

          const rightW = 170;
          const rightX = canvas.width - rightW - 18;
          const rightY = 16;
          const progressW = rightW - 22;
          const progressX = rightX + 11;
          const progressY = rightY + 28;

          ctx.save();
          const rightGrad = ctx.createLinearGradient(
            rightX,
            rightY,
            rightX + rightW,
            rightY + 48,
          );
          rightGrad.addColorStop(0, "rgba(22, 28, 35, 0.92)");
          rightGrad.addColorStop(1, "rgba(11, 15, 21, 0.92)");
          ctx.fillStyle = rightGrad;
          ctx.beginPath();
          ctx.roundRect(rightX, rightY, rightW, 48, 12);
          ctx.fill();
          ctx.strokeStyle = "rgba(255, 210, 98, 0.9)";
          ctx.lineWidth = 1.6;
          ctx.stroke();

          ctx.font = "bold 11px ArcadeFont, monospace";
          ctx.fillStyle = "rgba(220, 234, 255, 0.8)";
          ctx.fillText("COINS", rightX + 12, rightY + 15);
          ctx.fillStyle = "#f8d764";
          ctx.fillText(
            String(coinsCollected),
            rightX + rightW - 28,
            rightY + 15,
          );

          ctx.fillStyle = "rgba(255,255,255,0.08)";
          ctx.fillRect(progressX, progressY, progressW, 7);
          const stageProgress = Math.min(
            1,
            (cameraX + V_WIDTH * 0.35) / LEVEL_WIDTH,
          );
          const barGrad = ctx.createLinearGradient(
            progressX,
            progressY,
            progressX + progressW,
            progressY + 7,
          );
          barGrad.addColorStop(0, "#7dd3fc");
          barGrad.addColorStop(1, "#60a5fa");
          ctx.fillStyle = barGrad;
          ctx.fillRect(progressX, progressY, progressW * stageProgress, 7);
          ctx.restore();
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      function startGame() {
        gameState = "PLAYING";
        menuScreen.style.display = "none";
        touchControls.classList.remove("hidden");
        pauseBtn.style.display = "none";
        muteBtn.style.display = "none";
        pauseBtn.classList.add("hidden");
        muteBtn.classList.add("hidden");
        gameOverModal.classList.add("hidden");
        victoryModal.classList.add("hidden");
        pauseModal.classList.add("hidden");
        maxHp = 3;
        hp = 3;
        lives = 3;
        coinsCollected = 0;
        flagPole.reached = false;
        enemyProjectiles.length = 0;
        particles.length = 0;
        floatingTexts.length = 0;
        effects.length = 0;
        enemies = initialEnemies.map((e) => ({
          ...e,
          dead: false,
          vx: e.vx || 0,
          vy: 0,
          onGround: false,
        }));
        items = initialItems.map((it) => ({ ...it, collected: false }));
        resetPlayer();
        playRandomActionMusic();
      }

      function togglePause() {
        if (gameState === "PLAYING") {
          gameState = "PAUSED";
          pauseModal.classList.remove("hidden");
          pauseAllMusic();
          Sfx.pause();
        } else if (gameState === "PAUSED") {
          gameState = "PLAYING";
          pauseModal.classList.add("hidden");
          resumeMusic();
          Sfx.click();
        }
      }

      function toggleMute() {
        musicMuted = !musicMuted;
        muteBtn.textContent = musicMuted ? "OFF" : "ON";
        if (musicMuted) pauseAllMusic();
        else resumeMusic();
      }

      btnPlay.onclick = () => {
        Sfx.click();
        startGame();
      };
      restartBtn.onclick = () => {
        Sfx.click();
        stopActionMusic();
        startGame();
      };
      victoryBtn.onclick = () => {
        Sfx.click();
        stopActionMusic();
        startGame();
      };
      resumeBtn.onclick = togglePause;
      pauseBtn.onclick = togglePause;
      muteBtn.onclick = toggleMute;
      document.getElementById("btnOptions").onclick = () => {
        Sfx.click();
        alert("Áudio: 100% | Dificuldade: Normal");
      };
      document.getElementById("btnCredits").onclick = () => {
        Sfx.click();
        alert("Pirate Adventure - Pixel Frog & Natasha Arcade");
      };

      window.addEventListener("keydown", (e) => {
        if (["ArrowLeft", "KeyA"].includes(e.code)) keys.l = true;
        if (["ArrowRight", "KeyD"].includes(e.code)) keys.r = true;
        if (["Space", "KeyW", "ArrowUp"].includes(e.code)) {
          if (gameState === "PLAYING") handleJump();
          else if (gameState === "MENU") startGame();
        }
        if (e.code === "Escape" || e.code === "KeyP") {
          if (gameState === "PLAYING" || gameState === "PAUSED") togglePause();
        }
      });
      window.addEventListener("keyup", (e) => {
        if (["ArrowLeft", "KeyA"].includes(e.code)) keys.l = false;
        if (["ArrowRight", "KeyD"].includes(e.code)) keys.r = false;
      });

      // Pausa automaticamente se o jogador trocar de aba (evita "pulos fantasma" ao voltar)
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && gameState === "PLAYING") togglePause();
      });

      const bindTouch = (id, onDown, onUp) => {
        const el = document.getElementById(id);
        el.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          onDown();
        });
        el.addEventListener("pointerup", (e) => {
          e.preventDefault();
          onUp();
        });
        el.addEventListener("pointerleave", () => onUp());
      };
      bindTouch(
        "btnLeft",
        () => (keys.l = true),
        () => (keys.l = false),
      );
      bindTouch(
        "btnRight",
        () => (keys.r = true),
        () => (keys.r = false),
      );
      document
        .getElementById("btnJump")
        .addEventListener("pointerdown", (e) => {
          e.preventDefault();
          handleJump();
        });

      loop();
      playMenuMusic();
    </script>
  </body>
</html>
